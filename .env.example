# NUVENDRY Environment Configuration (Template)
# Copy this file to .env and fill with your own secrets

# Core App & Security
SECRET_KEY=replace_with_a_secure_random_hex_key_for_production
DEMO_MODE=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://nuvendry:your_secure_db_password@127.0.0.1:55432/nuvendry

# PayPal Sandbox Credentials
# Register at developer.paypal.com to obtain Sandbox test credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Optional Ollama model for the learning advisor and AI Offer Studio
OLLAMA_MODEL=
# Docker defaults to http://host.docker.internal:11434 when this is unset.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional DeepSeek provider for the learning advisor
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
